
#include "/home/aarti/Aarti_new/layer3_filter/class_layer3.h"
#include <iostream>
#include <vector>
#include <string>
#include <limits>
#include <sstream>
#include <algorithm> // for std::min
int main() {
    // Step 1: Read and parse the CSV file
    bool has_negative = false;
    std::vector<std::vector<double>> values = readCSV("/home/aarti/Aarti_new/layer3_filter/data_set.csv", has_negative);
    if (values.empty()) {
        return 1; // Exit if file read fails
    }

    // Step 2: Reshape the data once for both cases, considering only the first user
    std::vector<std::vector<double>> reshapedMeasurements = reshapeMeasurementsForParallel(values);

    // Step 3: Case AtoC
    std::cout << "Case AtoC" << std::endl;
    double initialMeasurementAtoC = 0.0; // Starting with 0.0
    MeasurementFilter filterAtoC(initialMeasurementAtoC, 4, -180, 18);

    for (const auto& slot : reshapedMeasurements) {
        double average = filterAtoC.processSlot(slot);
        std::vector<double> avgVector = {average};
        filterAtoC.update(avgVector);
    }

    //std::cout << "Final Fn_prev (AtoC): " << filterAtoC.getFinalFilteredMeasurement() << std::endl;

  
    // Output filtered measurements for AtoC
    // Print or use the results as needed
    std::vector<double> filteredMeasurementsAtoC = filterAtoC.getFilteredMeasurements();
    std::cout << "Filtered Measurements for AtoC:" << std::endl;
    for (double measurement : filteredMeasurementsAtoC) {
        std::cout << measurement << " ";
    }
    std::cout << std::endl;
      // Step 4: Case AtoE
    std::cout << "Case AtoE" << std::endl;
    double initialMeasurementAtoE = 0.0; // Starting with 0.0
    MeasurementFilter filterAtoE(initialMeasurementAtoE, 4, 18); // Using the new constructor without absThreshSS_BlocksConsolidation

    filterAtoE.updateParallelAtoE(reshapedMeasurements);

    
    std::vector<double> filteredMeasurementsAtoE = filterAtoE.getFilteredMeasurements();


    // Output filtered measurements for AtoE
    std::cout << "Filtered Measurements for AtoE:" << std::endl;
    for (double measurement : filteredMeasurementsAtoE) {
        std::cout << measurement << " ";
    }

    std::cout << std::endl;
    return 0;
}

